.btn-primary{background-color: #e85d0f; color: #fff; border-radius: 5px; padding: 0.5rem 1rem; font-size: 14px; font-weight: 600; text-decoration: none;}
.btn-primary:hover{background-color: #ffb992; color: #000; text-decoration: none; border: 1px solid #ffb992;}
.footer-dnc{
    background-image: linear-gradient(rgb(255, 255, 255), rgb(255, 255, 255)) !important; color: #043835;
    a{color: #043835 !important;}
}
.employes-cta-info-detail{
    background-image: linear-gradient(rgba(243, 244, 242, 1), rgba(243, 244, 242, 1)) !important; color: #043835;
    box-shadow: none !important;
    border: none !important;
}
.employes-cta-info-detail{
    a{color: #043835 !important;}
}
.sitefooter__copyright p{   color: #043835 !important;}
.box-shadow-extend, .employes-head .employes-thumb img, .employes-get-in-touch, .employess-info-block .about-employes, .employess-info-block .employes-cta-info, .employes-cta-info-detail {
